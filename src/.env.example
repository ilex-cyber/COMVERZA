APP_NAME=COMVERZA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=America/Mexico_City

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de datos (MariaDB del docker-compose)
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=comverza
DB_USERNAME=comverza
DB_PASSWORD=comverza_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Correo: por defecto Mailpit (bandeja de pruebas en http://localhost:8025).
# Para enviar correos reales con Gmail usa:
#   MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=null
#   MAIL_USERNAME=tu_correo@gmail.com  MAIL_PASSWORD=contraseña_de_aplicación
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@comverza.com"
MAIL_FROM_NAME="${APP_NAME}"
# Buzón que recibe los mensajes del formulario de contacto y alertas
COMVERZA_ADMIN_EMAIL="admin@comverza.com"

VITE_APP_NAME="${APP_NAME}"
